# ─────────────────────────────────────────────────────────────────────────────
# Variables de entorno de Dextra Law Firm (web)
#
# Copia este archivo como .env.local para desarrollo. En producción, créalas en
# Vercel → Project → Settings → Environment Variables. NUNCA subas .env.local.
#
# IMPORTANTE: las variables con prefijo VITE_ se incrustan en el JavaScript
# público. No pongas nunca una clave secreta con ese prefijo.
# ─────────────────────────────────────────────────────────────────────────────

# Pública. Dominio canónico, sin barra final. Se usa en canonical, sitemap,
# Open Graph, JSON-LD y para verificar el origen del formulario.
VITE_SITE_URL=https://dextralawfirm.com

# ── Formulario de contacto (solo servidor: api/contact.ts) ──────────────────
# El formulario NO envía nada mientras CONTACT_FORM_ENABLED no sea "true".
# Antes de activarlo: crear la cuenta de Resend, añadir el dominio eligiendo la
# región eu-west-1 (Irlanda), verificar los registros DNS (SPF, DKIM) y revisar
# y aceptar el DPA de Resend.
CONTACT_FORM_ENABLED=false

# Clave de API de Resend con permiso solo de envío ("Sending access").
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario.
CONTACT_TO_EMAIL=info@dextralawfirm.com

# Remitente: debe pertenecer al dominio verificado en Resend.
# Ejemplo: "Web Dextra Law Firm <web@dextralawfirm.com>"
CONTACT_FROM_EMAIL=

# Opcional. Otros orígenes permitidos para el formulario, separados por comas
# (p. ej. el dominio de vercel.app mientras no esté activo el dominio propio).
ALLOWED_ORIGINS=
